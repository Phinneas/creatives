---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Privacy Policy — Salish Sea Creatives"
  description="How Salish Sea Creatives handles your data."
  page="legal"
>
  <main id="main">
    <section class="statement" aria-labelledby="legal-h">
      <div class="wrap" style="max-width:820px">
        <span class="label reveal">Legal</span>
        <h1 id="legal-h" class="reveal" style="margin-top:26px;font-size:clamp(34px,4.4vw,58px)">Privacy Policy</h1>
        <div class="reveal" style="--d:.08s;margin-top:26px;color:var(--body);font-size:16.5px;line-height:1.7">
          <p>This policy is being finalized. Until it's live, here's the short version: Salish Sea Creatives collects only what's needed to respond to your inquiry — your name and email address when you contact us.</p>
          <p style="margin-top:16px">We do not sell your information. If you have questions about how your data is handled, email <a style="color:var(--teal-ink)" href="mailto:chester@salishseaconsulting.com">chester@salishseaconsulting.com</a>.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
