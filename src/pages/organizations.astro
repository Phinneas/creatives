---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Templates for Sustainability Organizations — Salish Sea Creatives"
  description="Premium Framer and Ghost templates for environmental nonprofits, conservation brands, and sustainability-driven organizations. Pacific Northwest studio."
  page="organizations"
  footTagline="Premium templates for organizations that mean it."
  footTemplates={[
    { label: 'Environmental nonprofit (Framer)', href: '#templates' },
    { label: 'Conservation brand (Framer)', href: '#templates' },
    { label: 'Sustainability publisher (Ghost)', href: '#templates' },
  ]}
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="mosaic">
          <div class="col">
            <div class="tile tile-sage">
              <span class="label on-sage">For organizations</span>
              <h1 id="hero-h" style="margin-top:20px;">Your mission deserves<br />a site that means it.</h1>
              <p class="sub">Premium Framer and Ghost templates designed for environmental nonprofits, conservation organizations, and sustainability brands. Built by a studio that shares your values.</p>
            </div>
            <a class="cta-tile" href="#templates">
              <span class="t">Browse organization templates</span>
              <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
            </a>
          </div>
          <div class="tile tile-slate">
            <div class="flow">
              <div class="fcard">
                <span class="fchip">Framer</span>
                <span class="fh">Nonprofit</span>
                <span class="fline w80"></span><span class="fline"></span><span class="fline teal w60"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Framer</span>
                <span class="fh">Conservation</span>
                <span class="fline"></span><span class="fline w60"></span><span class="fline teal w80"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Ghost</span>
                <span class="fh">Publisher</span>
                <span class="fline w60"></span><span class="fline w80"></span><span class="fline teal"></span>
              </div>
            </div>
            <div class="flow-labels" aria-hidden="true"><span>Credible</span><i></i><span>Premium</span><i></i><span>Ready</span></div>
          </div>
        </div>
        <div style="margin-top:16px"><a class="btn btn-light" href="mailto:chester@salishseaconsulting.com?subject=Setup%20conversation">Talk to us about setup <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="statement sage-band" id="credentials" aria-labelledby="cred-h">
      <div class="wrap">
        <span class="label on-sage reveal">Studio background</span>
        <p class="big reveal" id="cred-h" style="--d:.08s;max-width:860px">We’ve spent fifteen years in sustainability communications — and volunteered alongside the organizations we build for.</p>
        <div class="creds reveal" style="--d:.14s"><span class="cred">Sierra Club Washington</span><span class="cred">The Nature Conservancy</span><span class="cred">Blue Standard Certification</span><span class="cred">15+ years sustainability comms</span><span class="cred">Grant writing certified</span></div>
      </div>
    </section>

    <section class="statement" id="templates" style="padding-bottom:clamp(40px,6vw,72px)" aria-labelledby="tpl-h">
      <div class="wrap">
        <span class="label quiet reveal">Templates</span>
        <p class="big reveal" id="tpl-h" style="--d:.08s;max-width:800px">Templates built for mission-driven work.</p>
        <div class="grid3">
          <article class="tpl reveal">
            <span class="idx">01</span>
            <h3>Environmental nonprofit — Framer</h3>
            <p>[PLACEHOLDER: Framer — environmental nonprofit]</p>
            <div class="chips"><span class="chip">Framer</span><span class="chip">No code</span><span class="chip">Setup included</span></div>
            <div class="foot">
              <span class="price">$249</span>
              <a class="go" href="mailto:chester@salishseaconsulting.com?subject=Template%20and%20setup">Get this + setup <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="tpl reveal">
            <span class="idx">02</span>
            <h3>Conservation brand — Framer</h3>
            <p>[PLACEHOLDER: Framer — conservation brand]</p>
            <div class="chips"><span class="chip">Framer</span><span class="chip">No code</span><span class="chip">Setup included</span></div>
            <div class="foot">
              <span class="price">$249</span>
              <a class="go" href="mailto:chester@salishseaconsulting.com?subject=Template%20and%20setup">Get this + setup <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="tpl reveal">
            <span class="idx">03</span>
            <h3>Sustainability publisher — Ghost</h3>
            <p>[PLACEHOLDER: Ghost — sustainability publisher]</p>
            <div class="chips"><span class="chip">Ghost</span><span class="chip">Memberships</span><span class="chip">Setup included</span></div>
            <div class="foot">
              <span class="price">$249</span>
              <a class="go" href="mailto:chester@salishseaconsulting.com?subject=Template%20and%20setup">Get this + setup <span aria-hidden="true">→</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="statement" style="padding-top:clamp(40px,6vw,72px)" aria-labelledby="why-h">
      <div class="wrap">
        <span class="label quiet reveal">Why us</span>
        <p class="big reveal" id="why-h" style="--d:.08s;max-width:800px">Why organizations choose us.</p>
        <div class="vals">
          <div class="val reveal" style="--d:.05s"><div class="rule"></div><h3>Values alignment</h3><p>We’ve volunteered with Sierra Club Washington and The Nature Conservancy. We understand your mission because we share it.</p></div>
          <div class="val reveal" style="--d:.14s"><div class="rule"></div><h3>Premium design</h3><p>Your organization’s credibility depends on how it presents itself. These templates communicate authority and purpose.</p></div>
          <div class="val reveal" style="--d:.23s"><div class="rule"></div><h3>Setup included</h3><p>We handle the technical setup. You get a live site configured, branded, and ready to publish — so your team can focus on the work that matters.</p></div>
        </div>
      </div>
    </section>

    <div class="wrap">
      <section class="final reveal" aria-labelledby="cta-h">
        <div>
          <h2 id="cta-h">Built by people who <span class="gold">share</span> your mission.</h2>
          <p>Tell us about your organization. We’ll take it from there.</p>
        </div>
        <a class="btn btn-light" href="mailto:chester@salishseaconsulting.com?subject=Setup%20conversation">Talk to us <span class="arr" aria-hidden="true">→</span></a>
      </section>
    </div>
  </main>
</Layout>
