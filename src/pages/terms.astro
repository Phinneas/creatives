---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Terms of Service — Salish Sea Creatives"
  description="Terms for purchasing and using Salish Sea Creatives templates."
  page="legal"
>
  <main id="main">
    <section class="statement" aria-labelledby="legal-h">
      <div class="wrap" style="max-width:820px">
        <span class="label reveal">Legal</span>
        <h1 id="legal-h" class="reveal" style="margin-top:26px;font-size:clamp(34px,4.4vw,58px)">Terms of Service</h1>
        <div class="reveal" style="--d:.08s;margin-top:26px;color:var(--body);font-size:16.5px;line-height:1.7">
          <p>Full terms are being finalized. The short version: templates are licensed for use on a single project per purchase, and you're free to adapt them for your own client work. Redistribution or resale of the templates themselves is not permitted.</p>
          <p style="margin-top:16px">For specifics, email <a style="color:var(--teal-ink)" href="mailto:chester@salishseaconsulting.com">chester@salishseaconsulting.com</a>.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
