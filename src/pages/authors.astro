---
import Layout from '../layouts/Layout.astro'
import ProductCard from '../components/ProductCard.astro'
import { products } from '../data/products'

const authorProducts = products.filter((p) => p.audience === 'authors')
---

<Layout
  title="Ghost &amp; Framer Templates for Authors — Salish Sea Creatives"
  description="Beautiful Ghost and Framer templates designed for writers, bloggers, and book authors. Your words deserve a home this good. Setup included."
  page="authors"
  footTagline="Beautiful templates for writers and authors."
  footTemplates={[
    { label: 'Editorial (Ghost)', href: '#templates' },
    { label: 'Newsletter (Ghost)', href: '#templates' },
    { label: 'Book author (Framer)', href: '#templates' },
  ]}
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="mosaic">
          <div class="col">
            <div class="tile tile-sage">
              <span class="label on-sage">For authors</span>
              <h1 id="hero-h" style="margin-top:20px;">Your words deserve<br />a beautiful home.</h1>
              <p class="sub">Ghost and Framer templates designed for writers, bloggers, and book authors. No code required. We handle the setup so you can focus on writing.</p>
            </div>
            <a class="cta-tile" href="#templates">
              <span class="t">Browse author templates</span>
              <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
            </a>
          </div>
          <div class="tile tile-slate">
            <div class="flow">
              <div class="fcard">
                <span class="fchip">Ghost</span>
                <span class="fh">Editorial</span>
                <span class="fline w80"></span><span class="fline"></span><span class="fline teal w60"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Ghost</span>
                <span class="fh">Newsletter</span>
                <span class="fline"></span><span class="fline w60"></span><span class="fline teal w80"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Framer</span>
                <span class="fh">Book author</span>
                <span class="fline w60"></span><span class="fline w80"></span><span class="fline teal"></span>
              </div>
            </div>
            <div class="flow-labels" aria-hidden="true"><span>Write</span><i></i><span>Publish</span><i></i><span>Grow</span></div>
          </div>
        </div>
        <div style="margin-top:16px"><a class="btn btn-light" href="mailto:chester@salishseaconsulting.com?subject=Template%20setup">Get it set up for me <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="statement sage-band" id="how" aria-labelledby="how-h">
      <div class="wrap">
        <span class="label on-sage reveal">How it works</span>
        <p class="big reveal" id="how-h" style="--d:.08s;max-width:820px">Choose a template. We set it up. You start writing.</p>
        <div class="two reveal" style="--d:.14s">
          <div>
            <!-- DRAFT testimonials — replace with real author quotes before launch -->
            <div class="quote">“I went from a blank Ghost install to a published post in an afternoon. The setup saved me days.”</div>
            <div class="quote">“The editorial theme finally makes my essays look as good as they read.”</div>
            <div class="quote">“They set everything up and my newsletter list was live before I'd finished my first draft.”</div>
          </div>
          <div>
            <div class="step"><span class="num">01</span><div><span class="t">Choose your template</span><p>Pick the Ghost or Framer template that fits your writing.</p></div></div>
            <div class="step"><span class="num">02</span><div><span class="t">We set it up</span><p>We configure hosting, the editor, and your branding for you.</p></div></div>
            <div class="step"><span class="num">03</span><div><span class="t">You start writing</span><p>A live site and a first post published — in 48 hours.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="statement" id="templates" style="padding-bottom:clamp(40px,6vw,72px)" aria-labelledby="tpl-h">
      <div class="wrap">
        <span class="label quiet reveal">Templates</span>
        <p class="big reveal" id="tpl-h" style="--d:.08s;max-width:800px">Templates for writers and authors. Setup included with every one.</p>
        <div class="grid3">
          {authorProducts.map((product, i) => (
            <ProductCard product={product} idx={String(i + 1).padStart(2, '0')} />
          ))}
        </div>
      </div>
    </section>

    <section class="statement" style="padding-top:clamp(40px,6vw,72px)" aria-labelledby="why-h">
      <div class="wrap">
        <span class="label quiet reveal">Why Ghost</span>
        <p class="big reveal" id="why-h" style="--d:.08s;max-width:800px">Everything a writer needs. Nothing they don’t.</p>
        <div class="vals">
          <div class="val reveal" style="--d:.05s"><div class="rule"></div><h3>Ghost’s built-in editor</h3><p>Write in Ghost’s clean editor — no Markdown, no code, just writing.</p></div>
          <div class="val reveal" style="--d:.14s"><div class="rule"></div><h3>Newsletter built in</h3><p>Ghost handles memberships and newsletters natively. Substack-style, but yours.</p></div>
          <div class="val reveal" style="--d:.23s"><div class="rule"></div><h3>Setup included</h3><p>We configure everything. You get a live site, a working editor, and a first post published — in 48 hours.</p></div>
        </div>
      </div>
    </section>

    <div class="wrap">
      <section class="final reveal" aria-labelledby="cta-h">
        <div>
          <h2 id="cta-h">Let’s get you <span class="gold">published</span>.</h2>
          <p>Tell us what you write. We’ll handle the rest.</p>
        </div>
        <a class="btn btn-light" href="mailto:chester@salishseaconsulting.com?subject=Setup%20service">Talk to us <span class="arr" aria-hidden="true">→</span></a>
      </section>
    </div>
  </main>
</Layout>
