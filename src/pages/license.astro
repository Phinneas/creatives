---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="License — Salish Sea Creatives"
  description="Licensing terms for Salish Sea Creatives templates."
  page="legal"
>
  <main id="main">
    <section class="statement" aria-labelledby="legal-h">
      <div class="wrap" style="max-width:820px">
        <span class="label reveal">Legal</span>
        <h1 id="legal-h" class="reveal" style="margin-top:26px;font-size:clamp(34px,4.4vw,58px)">License</h1>
        <div class="reveal" style="--d:.08s;margin-top:26px;color:var(--body);font-size:16.5px;line-height:1.7">
          <p>The exact license for each template is being finalized. Our intent: one purchase covers use on one project, including client work — you keep the site, the code stays yours, with no platform lock-in.</p>
          <p style="margin-top:16px">For the current license details, email <a style="color:var(--teal-ink)" href="mailto:chester@salishseaconsulting.com">chester@salishseaconsulting.com</a>.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
