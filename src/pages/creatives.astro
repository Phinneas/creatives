---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Portfolio &amp; Studio Templates for Creatives — Salish Sea Creatives"
  description="Portfolio, studio, and showcase templates for designers, agencies, and independent creatives. Built to present the work. Pacific Northwest studio."
  page="creatives"
  footTagline="Portfolio and studio templates for creatives."
  footTemplates={[
    { label: 'Portfolio (Framer)', href: '#templates' },
    { label: 'Studio (Framer)', href: '#templates' },
    { label: 'Case studies (Astro)', href: '#templates' },
  ]}
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="mosaic">
          <div class="col">
            <div class="tile tile-sage">
              <span class="label on-sage">For creatives</span>
              <h1 id="hero-h" style="margin-top:20px;">A portfolio that<br />does your work justice.</h1>
              <p class="sub">Portfolio, studio, and showcase templates for designers, agencies, and independent creatives. Built to present the work — not compete with it.</p>
            </div>
            <a class="cta-tile" href="#templates">
              <span class="t">Browse creative templates</span>
              <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
            </a>
          </div>
          <div class="tile tile-slate">
            <div class="flow">
              <div class="fcard">
                <span class="fchip">Framer</span>
                <span class="fh">Portfolio</span>
                <span class="fline w80"></span><span class="fline"></span><span class="fline teal w60"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Framer</span>
                <span class="fh">Studio</span>
                <span class="fline"></span><span class="fline w60"></span><span class="fline teal w80"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Astro</span>
                <span class="fh">Case studies</span>
                <span class="fline w60"></span><span class="fline w80"></span><span class="fline teal"></span>
              </div>
            </div>
            <div class="flow-labels" aria-hidden="true"><span>Showcase</span><i></i><span>Launch</span><i></i><span>Win work</span></div>
          </div>
        </div>
        <div style="margin-top:16px"><a class="btn btn-light" href="mailto:chester@salishseaconsulting.com?subject=Setup%20conversation">Talk to us about setup <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="statement sage-band" id="credentials" aria-labelledby="cred-h">
      <div class="wrap">
        <span class="label on-sage reveal">Studio background</span>
        <p class="big reveal" id="cred-h" style="--d:.08s;max-width:860px">We’re practitioners — designers and writers who’ve shipped portfolios, brand sites, and case studies for years.</p>
        <div class="creds reveal" style="--d:.14s"><span class="cred">15+ years design &amp; copy</span><span class="cred">Brand identity systems</span><span class="cred">Framer + Astro</span><span class="cred">No-code handoff</span><span class="cred">Agency + freelance</span></div>
      </div>
    </section>

    <section class="statement" id="templates" style="padding-bottom:clamp(40px,6vw,72px)" aria-labelledby="tpl-h">
      <div class="wrap">
        <span class="label quiet reveal">Templates</span>
        <p class="big reveal" id="tpl-h" style="--d:.08s;max-width:800px">Built to present the work, not compete with it.</p>
        <div class="grid3">
          <article class="tpl reveal">
            <span class="idx">01</span>
            <h3>Portfolio — Framer</h3>
            <p>A minimal, image-led portfolio for designers and illustrators. No code, instant polish.</p>
            <div class="chips"><span class="chip">Framer</span><span class="chip">No code</span><span class="chip">Setup included</span></div>
            <div class="foot">
              <span class="price">$149</span>
              <a class="go" href="mailto:chester@salishseaconsulting.com?subject=Template%20and%20setup">Get this + setup <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="tpl reveal">
            <span class="idx">02</span>
            <h3>Studio — Framer</h3>
            <p>A full agency site: case studies, services, and a contact pipeline built in.</p>
            <div class="chips"><span class="chip">Framer</span><span class="chip">No code</span><span class="chip">Setup included</span></div>
            <div class="foot">
              <span class="price">$249</span>
              <a class="go" href="mailto:chester@salishseaconsulting.com?subject=Template%20and%20setup">Get this + setup <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <article class="tpl reveal">
            <span class="idx">03</span>
            <h3>Case studies — Astro</h3>
            <p>A content-first showcase for teams who write about their work. Headless, fast, yours.</p>
            <div class="chips"><span class="chip">Astro</span><span class="chip">Headless</span><span class="chip">Setup included</span></div>
            <div class="foot">
              <span class="price">$149</span>
              <a class="go" href="mailto:chester@salishseaconsulting.com?subject=Template%20and%20setup">Get this + setup <span aria-hidden="true">→</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="statement" style="padding-top:clamp(40px,6vw,72px)" aria-labelledby="why-h">
      <div class="wrap">
        <span class="label quiet reveal">Why us</span>
        <p class="big reveal" id="why-h" style="--d:.08s;max-width:800px">Why creatives choose us.</p>
        <div class="vals">
          <div class="val reveal" style="--d:.05s"><div class="rule"></div><h3>Craft-first design</h3><p>These templates are a showcase themselves. Your work stays the hero, not the chrome around it.</p></div>
          <div class="val reveal" style="--d:.14s"><div class="rule"></div><h3>No code, no lock-in</h3><p>Framer for instant visual editing, Astro for headless control. Your site stays yours.</p></div>
          <div class="val reveal" style="--d:.23s"><div class="rule"></div><h3>Setup included</h3><p>We handle the technical setup. You get a live site configured, branded, and ready to present — in days, not weeks.</p></div>
        </div>
      </div>
    </section>

    <div class="wrap">
      <section class="final reveal" aria-labelledby="cta-h">
        <div>
          <h2 id="cta-h">Show the work.<br /><span class="gold">Win</span> the work.</h2>
          <p>Tell us what you make. We’ll take it from there.</p>
        </div>
        <a class="btn btn-light" href="mailto:chester@salishseaconsulting.com?subject=Setup%20conversation">Talk to us <span class="arr" aria-hidden="true">→</span></a>
      </section>
    </div>
  </main>
</Layout>
