---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Salish Sea Creatives — Premium templates for purposeful brands" page="home">
  <main id="main">
    <!-- ================= HERO MOSAIC ================= -->
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="mosaic">
          <div class="col">
            <div class="tile tile-sage">
              <span class="label on-sage">Pacific Northwest studio</span>
              <h1 id="hero-h" style="margin-top:20px;">Fewer decisions.<br />More shipping.</h1>
              <p class="sub">Astro, Ghost, and Framer templates for developers, authors, and creatives that mean it. Production-ready, not wireframes.</p>
            </div>
            <a class="cta-tile" href="#lanes">
              <span class="t">Browse templates</span>
              <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
            </a>
          </div>

          <div class="tile tile-slate">
            <div class="flow">
              <div class="fcard">
                <span class="fchip">Astro + CMS</span>
                <span class="fh">Typed starters</span>
                <span class="fline w80"></span>
                <span class="fline"></span>
                <span class="fline teal w60"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Ghost + Framer</span>
                <span class="fh">Setup included</span>
                <span class="fline"></span>
                <span class="fline w60"></span>
                <span class="fline teal w80"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Framer + Astro</span>
                <span class="fh">Portfolio-ready</span>
                <span class="fline w60"></span>
                <span class="fline w80"></span>
                <span class="fline teal"></span>
              </div>
            </div>
            <div class="flow-labels" aria-hidden="true">
              <span>Developers</span><i></i><span>Authors</span><i></i><span>Creatives</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= COMPATIBLE ================= -->
    <section class="compat" aria-label="Compatible content platforms">
      <div class="wrap">
        <p>Built to pair with the headless stack you already run</p>
        <div class="compat-row">
          <span>Pages CMS</span><span>Payload</span><span>Directus</span><span>Storyblok</span><span>Decap</span><span>Ghost</span><span>Framer</span>
        </div>
      </div>
    </section>

    <!-- ================= THE PROBLEM ================= -->
    <section class="statement" aria-labelledby="prob-h">
      <div class="wrap">
        <span class="label reveal">The problem</span>
        <p class="big reveal" id="prob-h" style="--d:.08s">Most templates are demos. They look finished, then fall apart the moment real content, a real CMS, and a real deadline arrive.</p>
      </div>
    </section>

    <!-- ================= THE SOLUTION / PORTAGE ================= -->
    <section class="statement sage-band" id="portage" aria-labelledby="sol-h">
      <div class="wrap">
        <span class="label on-sage reveal">The solution</span>
        <p class="big reveal" id="sol-h" style="--d:.08s">Instead of rebuilding from scratch on every platform migration, Portage carries your posts, pages, routes, and metadata across to Astro — structure intact.</p>

        <div class="converge reveal" style="--d:.16s" aria-hidden="true">
          <svg viewBox="0 0 1200 250" preserveAspectRatio="none" style="height:230px">
            <path class="ln" d="M0 15 H560 C740 15, 820 125, 960 125" />
            <path class="ln" d="M0 70 H580 C750 70, 830 125, 960 125" />
            <path class="ln" d="M0 125 H960" />
            <path class="ln" d="M0 180 H580 C750 180, 830 125, 960 125" />
            <path class="ln" d="M0 235 H560 C740 235, 820 125, 960 125" />
            <path class="out" d="M960 125 H1200" />
          </svg>
          <div class="cv-from">
            <span style="top:6%">Ghost</span>
            <span style="top:28%">Squarespace</span>
            <span style="top:50%">Substack</span>
            <span style="top:72%">Webflow</span>
            <span style="top:94%">WordPress</span>
          </div>
          <span class="cv-to">One Astro site →</span>
        </div>
      </div>
    </section>

    <!-- ================= LANES ================= -->
    <section class="statement" id="lanes" style="padding-bottom:clamp(40px,6vw,72px)" aria-labelledby="lane-h">
      <div class="wrap">
        <span class="label quiet reveal">Templates</span>
        <p class="big reveal" id="lane-h" style="--d:.08s;max-width:800px">One lane per audience. Every template ships production-ready.</p>
        <div class="lanes reveal" style="--d:.12s">
          <a class="lane" data-speed="1" href="/developers/">
            <span class="label quiet" style="background:var(--light);align-self:flex-start">Astro + CMS</span>
            <h3>For developers</h3>
            <p>Five Astro starters wired to Pages CMS, Payload, Directus, Storyblok, and Decap. Schema ships with every template.</p>
            <span class="foot"><span class="from">From <b>Free</b></span><span class="go">Browse all <span aria-hidden="true">→</span></span></span>
          </a>
          <a class="lane" data-speed="-1" href="/authors/">
            <span class="label quiet" style="background:var(--light);align-self:flex-start">Ghost + Framer</span>
            <h3>For authors</h3>
            <p>Editorial, newsletter, and book-author templates. We handle the setup so you can write.</p>
            <span class="foot"><span class="from">From <b>$149</b></span><span class="go">Browse all <span aria-hidden="true">→</span></span></span>
          </a>
          <a class="lane" data-speed="2" href="/creatives/">
            <span class="label quiet" style="background:var(--light);align-self:flex-start">Framer + Astro</span>
            <h3>For creatives</h3>
            <p>Portfolio and studio templates for designers and agencies. Built to present the work, not compete with it.</p>
            <span class="foot"><span class="from">From <b>$149</b></span><span class="go">Browse all <span aria-hidden="true">→</span></span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= WHY US ================= -->
    <section class="statement" style="padding-top:clamp(40px,6vw,72px)" aria-labelledby="why-h">
      <div class="wrap">
        <span class="label quiet reveal">Why us</span>
        <p class="big reveal" id="why-h" style="--d:.08s;max-width:820px">We build sites the way we'd want to buy one.</p>
        <div class="bento reveal" style="--d:.12s">
          <article class="bento-card b-wide">
            <h3>Craft-first design</h3>
            <p>Most templates are a container. Fill in your logo, swap a photo, ship. Ours are built to be looked at first — proof that thought went into every line and space before your work ever touched the page. Your work stays the hero. The template is just the frame that gets out of the way.</p>
          </article>
          <article class="bento-card b-slate">
            <h3>No code, no lock-in</h3>
            <p>We build in Framer when you want to touch every pixel yourself, and Astro when you want a fast, headless site a CMS can feed for years. Nothing here is proprietary. No plugin you can't replace, no platform holding your content hostage. If you ever want to leave, you take everything with you.</p>
          </article>
          <article class="bento-card b-mint">
            <h3>Custom copy, not filler</h3>
            <p>I write the copy myself, for your site specifically. Not a placeholder paragraph you're supposed to swap out later, not something generated to sound like every other template on the market. It's written to sound like you, for what you actually do.</p>
          </article>
          <article class="bento-card b-sage">
            <h3>Sustainably hosted</h3>
            <p>Every site we build runs on green hosting. Your work looks good and costs the planet less to serve.</p>
          </article>
          <article class="bento-card b-dark">
            <h3>Setup included</h3>
            <p>Buying a template is the easy part. Getting it live, branded, and something you'd actually show a client is where most people stall out for weeks. We close that gap. Days, not weeks.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= FINAL CTA ================= -->
    <div class="wrap">
      <section class="final reveal" aria-labelledby="cta-h">
        <div>
          <h2 id="cta-h">Start with <span class="gold">Pages CMS</span>.</h2>
          <p>Astro + Pages CMS, zero CMS cost, on the Astro themes gallery.</p>
        </div>
        <a class="btn btn-light" href="https://astro.build/themes/" target="_blank" rel="noopener noreferrer">Get it free <span class="arr" aria-hidden="true">→</span></a>
      </section>
    </div>
  </main>
</Layout>
