---
import Layout from '../layouts/Layout.astro'
import ProductCard from '../components/ProductCard.astro'
import { products, allAccess } from '../data/products'

const devProducts = products.filter((p) => p.audience === 'developers')
const allAccessHref = allAccess.checkoutUrl || 'mailto:chester@salishseaconsulting.com?subject=All-access%20inquiry'
const allAccessLabel = allAccess.checkoutUrl ? 'Buy all-access' : 'Inquire about all-access'
---

<Layout
  title="Astro + CMS Templates for Developers — Salish Sea Creatives"
  description="Production-ready Astro templates wired to Pages CMS, Payload, Directus, and Storyblok. TypeScript, Tailwind v4, static output. No bloat."
  page="developers"
  footTagline="Premium templates for purposeful brands."
  footTemplates={[
    { label: 'Astro + Pages CMS', href: '#templates' },
    { label: 'Astro + Payload', href: '#templates' },
    { label: 'Astro + Directus', href: '#templates' },
  ]}
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="mosaic">
          <div class="col">
            <div class="tile tile-sage">
              <span class="label on-sage">For developers</span>
              <h1 id="hero-h" style="margin-top:20px;">Astro starters for<br />headless teams.</h1>
              <p class="sub">Production-ready Astro templates wired to Pages CMS, Payload, Directus, and Storyblok. Every template ships the CMS schema. No bloat. No lock-in.</p>
            </div>
            <a class="cta-tile" href="#templates">
              <span class="t">Browse templates</span>
              <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
            </a>
          </div>
          <div class="tile tile-slate">
            <div class="flow">
              <div class="fcard">
                <span class="fchip">Astro 6</span>
                <span class="fh">Typed schemas</span>
                <span class="fline w80"></span><span class="fline"></span><span class="fline teal w60"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">TypeScript</span>
                <span class="fh">Content collections</span>
                <span class="fline"></span><span class="fline w60"></span><span class="fline teal w80"></span>
              </div>
              <div class="dots" aria-hidden="true"><svg viewBox="0 0 44 14"><path d="M2 7h40" /></svg></div>
              <div class="fcard">
                <span class="fchip">Tailwind v4</span>
                <span class="fh">Static output</span>
                <span class="fline w60"></span><span class="fline w80"></span><span class="fline teal"></span>
              </div>
            </div>
            <div class="flow-labels" aria-hidden="true"><span>Typed</span><i></i><span>Content-ready</span><i></i><span>Zero JS</span></div>
          </div>
        </div>
        <div style="margin-top:16px"><a class="btn btn-light" href="https://github.com/Phinneas/creatives" target="_blank" rel="noopener noreferrer">View on GitHub <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="statement" style="padding-bottom:0" aria-labelledby="plat-h">
      <div class="wrap">
        <span class="label reveal">Compatible platforms</span>
        <p class="big reveal" id="plat-h" style="--d:.08s;max-width:800px">Three Astro pillars plus two single-template CMS pairings. Every template ships the CMS schema with it.</p>
        <div class="plats reveal" style="--d:.14s">
          <div class="plat"><span class="n">Pages CMS</span><span class="d">Zero cost, email invite for clients</span></div>
          <div class="plat"><span class="n">Payload</span><span class="d">TypeScript-native, self-hosted</span></div>
          <div class="plat"><span class="n">Directus</span><span class="d">Database-first, agency-tier</span></div>
          <div class="plat"><span class="n">Storyblok</span><span class="d">Visual editing, agency-tier</span></div>
          <div class="plat"><span class="n">Decap</span><span class="d">Git-based</span></div>
          <div class="plat soon"><span class="n">Ghost</span><span class="d">Publishing + Content API</span><span class="tag">Soon</span></div>
          <div class="plat soon"><span class="n">Framer</span><span class="d">Visual builder, client handoff</span><span class="tag">Soon</span></div>
          <div class="plat soon"><span class="n">Showit</span><span class="d">Drag-and-drop, zero code</span><span class="tag">Soon</span></div>
        </div>
      </div>
    </section>

    <section class="statement" id="templates" style="padding-bottom:clamp(40px,6vw,72px)" aria-labelledby="tpl-h">
      <div class="wrap">
        <span class="label quiet reveal">Templates</span>
        <p class="big reveal" id="tpl-h" style="--d:.08s;max-width:820px">Astro templates wired to real CMS platforms. Schema ships with the template — not just a theme.</p>
        <div class="grid3">
          {devProducts.map((product, i) => (
            <ProductCard product={product} idx={String(i + 1).padStart(2, '0')} />
          ))}

          <article class="pass reveal">
            <span class="lbl">All-access</span>
            <h3>{allAccess.name}</h3>
            <ul>
              {allAccess.perks.map((perk) => <li>{perk}</li>)}
            </ul>
            <div class="foot">
              <span class="amt">{allAccess.price}</span>
              <a class="btn btn-light" href={allAccessHref}>{allAccessLabel} <span class="arr" aria-hidden="true">→</span></a>
            </div>
          </article>
        </div>
        <div style="margin-top:44px"><span class="label quiet">Coming soon</span></div>
        <div class="grid4">
          <article class="tpl soon">
            <span class="idx">06</span>
            <h3>Ghost theme</h3>
            <span class="soon-pill">Coming soon</span>
          </article>
          <article class="tpl soon">
            <span class="idx">07</span>
            <h3>Framer template</h3>
            <span class="soon-pill">Coming soon</span>
          </article>
          <article class="tpl soon">
            <span class="idx">08</span>
            <h3>Showit template</h3>
            <span class="soon-pill">Coming soon</span>
          </article>
        </div>
      </div>
    </section>

    <section class="statement sage-band" id="migration" aria-labelledby="mig-h">
      <div class="wrap">
        <span class="label on-sage reveal">Portage · Migration toolkit</span>
        <p class="big reveal" id="mig-h" style="--d:.08s">Moving to Astro? Point Portage at your old platform and it carries your posts, pages, routes, and metadata across — structure intact.</p>
        <div class="two reveal" style="--d:.14s">
          <div>
            <div class="step"><span class="num">→</span><div><span class="t">ghost2astro</span><p>Ghost → Astro</p></div></div>
            <div class="step"><span class="num">→</span><div><span class="t">squarespace2astro</span><p>Squarespace → Astro</p></div></div>
            <div class="step"><span class="num">→</span><div><span class="t">substack2astro</span><p>Substack → Astro</p></div></div>
            <div class="step"><span class="num">→</span><div><span class="t">webflow2astro</span><p>Webflow → Astro</p></div></div>
          </div>
          <div style="align-self:center">
            <a class="btn btn-dark" href="https://portage.tools" target="_blank" rel="noopener noreferrer">Explore Portage <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="statement" id="why" aria-labelledby="why-h">
      <div class="wrap">
        <span class="label quiet reveal">Why Astro</span>
        <p class="big reveal" id="why-h" style="--d:.08s;max-width:760px">Engineered to stay out of the way.</p>
        <div class="vals">
          <div class="val reveal" style="--d:.05s"><div class="rule"></div><h3>Zero JS by default</h3><p>Pages ship as static HTML. Nothing hydrates until you ask it to.</p></div>
          <div class="val reveal" style="--d:.14s"><div class="rule"></div><h3>Content-ready architecture</h3><p>Content collections and typed schemas, wired in from the first commit.</p></div>
          <div class="val reveal" style="--d:.23s"><div class="rule"></div><h3>Framework agnostic islands</h3><p>Drop in React, Svelte, or Vue only where the page needs them.</p></div>
        </div>
      </div>
    </section>

    <div class="wrap">
      <section class="final reveal" aria-labelledby="cta-h">
        <div>
          <h2 id="cta-h">Start with <span class="gold">Pages CMS</span>.</h2>
          <p>Astro + Pages CMS, zero CMS cost, on the Astro themes gallery.</p>
        </div>
        <a class="btn btn-light" href="https://astro.build/themes/" target="_blank" rel="noopener noreferrer">Get it free <span class="arr" aria-hidden="true">→</span></a>
      </section>
    </div>
  </main>
</Layout>
