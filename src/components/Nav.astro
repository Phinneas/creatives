---
import type { Page } from '../layouts/Layout.astro'

interface Props {
  page?: Page
}
const { page = 'home' } = Astro.props

const contact = 'mailto:chester@salishseaconsulting.com'
const cta = page === 'home'
  ? { href: '#lanes', label: 'Browse templates' }
  : page === 'legal'
    ? { href: '/', label: 'Browse templates' }
    : { href: '#templates', label: 'Browse templates' }
---

<header class="nav" id="top">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Salish Sea Creatives home">
      <svg class="mark" width="30" height="30" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <path d="M3 17 C7 13, 9 13, 13 16 C17 19, 19 19, 23 15" stroke="#0E3A33" stroke-width="1.5" fill="none"/>
        <path d="M4 12 C8 8.5, 10 8.5, 13 11 C16 13.5, 18 13.5, 22 10" stroke="#0E3A33" stroke-width="1.5" fill="none" opacity="0.6"/>
        <path d="M5 7 C8.5 4.5, 10.5 4.5, 13 6.5 C15.5 8.5, 17.5 8.5, 21 6" stroke="#009689" stroke-width="1.5" fill="none" opacity="0.85"/>
      </svg>
      Salish Sea Creatives
    </a>

    <nav class="nav-links" id="navLinks" aria-label="Primary">
      {page !== 'home' && <a href="/">← All templates</a>}
      {page === 'home' && <a href="#lanes">Templates</a>}
      {page === 'home' && <a href="/authors/">For Authors</a>}
      {page === 'home' && <a href="/organizations/">For Organizations</a>}
      {page === 'home' && <a href="#portage">Portage</a>}
      {page === 'developers' && <a href="#templates">Templates</a>}
      {page === 'developers' && <a href="#migration">Migration Tools</a>}
      {page === 'developers' && <a href="#why">Why Astro</a>}
      {page === 'developers' && <a href="https://github.com/Phinneas/creatives" target="_blank" rel="noopener noreferrer">GitHub</a>}
      {page === 'authors' && <a href="#templates">Templates</a>}
      {page === 'authors' && <a href="#how">How it works</a>}
      {page === 'authors' && <a href="mailto:chester@salishseaconsulting.com?subject=Setup%20service">Setup Service</a>}
      {page === 'organizations' && <a href="#templates">Templates</a>}
      {page === 'organizations' && <a href="#credentials">Our credentials</a>}
      {page === 'organizations' && <a href="mailto:chester@salishseaconsulting.com?subject=Setup%20service">Setup Service</a>}
      <a href={contact}>Contact</a>
    </nav>

    <div style="display:flex;align-items:center;gap:10px;">
      <a class="btn btn-dark" href={cta.href}>Browse templates</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>
