---
// Shared bathymetric contour SVG used as hero background art on all pages
---

<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 660 600" role="presentation">
    <defs>
      <pattern id="g" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M28 0H0V28" fill="none" stroke="rgba(0,150,137,0.10)" stroke-width="1"/>
      </pattern>
    </defs>
    <rect x="0" y="0" width="660" height="600" fill="url(#g)" />
    <g transform="rotate(-15 330 300)">
      <path class="contour" style="animation-delay:.05s;opacity:.6"  d="M278 300 a52 40 0 1 0 104 0 a52 40 0 1 0 -104 0 Z"/>
      <path class="contour" style="animation-delay:.18s;opacity:.52" d="M218 296 a104 80 0 1 0 208 0 a104 80 0 1 0 -208 0 Z"/>
      <path class="contour" style="animation-delay:.34s;opacity:.44" d="M160 291 a158 122 0 1 0 316 0 a158 122 0 1 0 -316 0 Z"/>
      <path class="contour" style="animation-delay:.52s;opacity:.36" d="M96 286 a214 165 0 1 0 428 0 a214 165 0 1 0 -428 0 Z"/>
      <path class="contour" style="animation-delay:.72s;opacity:.28" d="M28 281 a272 208 0 1 0 544 0 a272 208 0 1 0 -544 0 Z"/>
    </g>
    <text class="depth-label" x="352" y="304">−20</text>
    <text class="depth-label" x="452" y="292">−60</text>
    <text class="depth-label" x="548" y="280">−120</text>
  </svg>
</div>
