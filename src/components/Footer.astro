---
interface Props {
  tagline?: string
  templates?: { label: string; href: string }[]
}

const {
  tagline = 'Premium templates for purposeful brands.',
  templates = [
    { label: 'Astro + CMS', href: '/developers/' },
    { label: 'Ghost Themes', href: '/authors/' },
    { label: 'Framer Templates', href: '/authors/' },
  ],
} = Astro.props

const tools = [
  { label: 'Portage', href: 'https://portage.tools' },
  { label: 'ghost2astro', href: 'https://portage.tools' },
  { label: 'webflow2astro', href: 'https://portage.tools' },
]
const audiences = [
  { label: 'Developers', href: '/developers/' },
  { label: 'Authors', href: '/authors/' },
  { label: 'Organizations', href: '/organizations/' },
]
---

<footer aria-label="Footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <span class="brand">
          <svg class="mark" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
            <path d="M3 17 C7 13, 9 13, 13 16 C17 19, 19 19, 23 15" stroke="#0E3A33" stroke-width="1.5"/>
            <path d="M4 12 C8 8.5, 10 8.5, 13 11 C16 13.5, 18 13.5, 22 10" stroke="#0E3A33" stroke-width="1.5" opacity="0.6"/>
            <path d="M5 7 C8.5 4.5, 10.5 4.5, 13 6.5 C15.5 8.5, 17.5 8.5, 21 6" stroke="#009689" stroke-width="1.5" opacity="0.85"/>
          </svg>
          Salish Sea Creatives
        </span>
        <p>{tagline}</p>
        <p class="parent">A product of <a href="https://www.salishseaconsulting.com" target="_blank" rel="noopener noreferrer">Salish Sea Consulting</a>.</p>
      </div>

      <div class="foot-col">
        <h4>Templates</h4>
        {templates.map((t) => <a href={t.href}>{t.label}</a>)}
      </div>

      <div class="foot-col">
        <h4>Tools</h4>
        {tools.map((t) => <a href={t.href} target="_blank" rel="noopener noreferrer">{t.label}</a>)}
      </div>

      <div class="foot-col">
        <h4>Audiences</h4>
        {audiences.map((t) => <a href={t.href}>{t.label}</a>)}
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} Salish Sea Creatives. Built in the Pacific Northwest.</span>
      <span class="legal"><a href="#">Privacy</a><a href="#">Terms</a><a href="#">License</a></span>
    </div>
  </div>
</footer>
